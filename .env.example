# Password condivisa per accedere al sito (vuota = nessuna password, solo per uso locale)
APP_PASSWORD=
# Chiave per firmare il cookie di sessione: metti una stringa lunga e casuale
SECRET_KEY=cambiami-con-una-stringa-lunga-e-casuale
# Valuta e lingua dei prezzi Google Flights
CURRENCY=EUR
LANGUAGE=it
# Query in parallelo verso Google Flights (tenerlo basso per non farsi bloccare)
MAX_CONCURRENCY=4
# Numero massimo di query per singola ricerca
MAX_QUERIES=48
# Durata cache risultati, in minuti
CACHE_TTL_MINUTES=30
